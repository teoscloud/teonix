#!/usr/bin/env bash
# hypr-perf [SECONDS] [ISOLATED_CPUS]
#
# Where does Hyprland's one render thread stand? Samples for SECONDS (default
# 10) and prints: main-thread CPU %, user/sys split, wakeups/s, the CPUs it ran
# on, its allowed CPU list, the GPU IRQ rate, the per-monitor modes, and any
# other thread caught running on the compositor's reserved CPUs (default: the
# thread's own Cpus_allowed_list, or ISOLATED_CPUS like "2,30").
#
# Reads only /proc, /sys and hyprctl; no root. Run before and after a change.
set -uo pipefail

secs=${1:-10}
iso=${2:-}
[[ $secs =~ ^[0-9]+$ && $secs -gt 0 ]] || { echo "usage: hypr-perf [seconds] [isolated-cpus]" >&2; exit 2; }

pid=$(pgrep -x Hyprland | head -1)
[[ -z $pid ]] && pid=$(pgrep -x .Hyprland-wrapp | head -1)
[[ -z $pid ]] && pid=$(pgrep -f '(^|/)Hyprland( |$)' | head -1)
[[ -z $pid ]] && { echo "hypr-perf: no Hyprland process" >&2; exit 1; }
tid=$pid                                  # main thread == render thread
st=/proc/$pid/task/$tid/stat
[[ -r $st ]] || { echo "hypr-perf: cannot read $st" >&2; exit 1; }

hz=$(getconf CLK_TCK 2>/dev/null || echo 100)

# stat fields after the comm: 14 utime, 15 stime, 39 processor.
stat_read() { awk '{print $14, $15, $39}' "$st"; }
ctxt_read() { awk '/^voluntary_ctxt_switches/ {v=$2} /^nonvoluntary_ctxt_switches/ {n=$2} END {print v+0, n+0}' "/proc/$pid/task/$tid/status"; }
gpu_irq_read() {
  awk '/i915|xe|amdgpu|nouveau/ {s=0; for (i=2; i<=NF; i++) if ($i ~ /^[0-9]+$/) s+=$i; t+=s} END {print t+0}' /proc/interrupts
}

allowed=$(awk '/^Cpus_allowed_list/ {print $2}' "/proc/$pid/task/$tid/status")
[[ -z $iso ]] && iso=$allowed

# Expand "2,30" / "0-3,8" into a lookup set.
declare -A iso_set=()
IFS=, read -ra parts <<<"$iso"
for p in "${parts[@]}"; do
  if [[ $p == *-* ]]; then
    for (( c = ${p%-*}; c <= ${p#*-}; c++ )); do iso_set[$c]=1; done
  elif [[ $p =~ ^[0-9]+$ ]]; then
    iso_set[$p]=1
  fi
done
iso_full=1
(( ${#iso_set[@]} >= $(nproc) )) && iso_full=0   # not isolated at all; skip intruder scan

read -r u0 s0 _ <<<"$(stat_read)"
read -r v0 n0 <<<"$(ctxt_read)"
g0=$(gpu_irq_read)
declare -A cpus_seen=() intruders=()
end=$(( SECONDS + secs ))
while (( SECONDS < end )); do
  read -r _ _ cpu <<<"$(stat_read)"
  cpus_seen[$cpu]=$(( ${cpus_seen[$cpu]:-0} + 1 ))
  if (( iso_full )); then
    # Every thread's last CPU (field 39). Anything on the reserved CPUs that is
    # not Hyprland's own is an intruder.
    while read -r tpid tcomm tcpu; do
      [[ -n ${iso_set[$tcpu]:-} ]] || continue
      [[ $tpid == "$pid" ]] && continue
      intruders["$tcomm($tpid)"]=$(( ${intruders["$tcomm($tpid)"]:-0} + 1 ))
    done < <(ps -eLo pid=,comm=,psr= 2>/dev/null | awk '{print $1, $2, $3}')
  fi
  sleep 0.25
done
read -r u1 s1 _ <<<"$(stat_read)"
read -r v1 n1 <<<"$(ctxt_read)"
g1=$(gpu_irq_read)

du=$(( u1 - u0 )); ds=$(( s1 - s0 ))
pct_user=$(awk -v d="$du" -v hz="$hz" -v s="$secs" 'BEGIN {printf "%.1f", d*100/hz/s}')
pct_sys=$(awk -v d="$ds" -v hz="$hz" -v s="$secs" 'BEGIN {printf "%.1f", d*100/hz/s}')
pct=$(awk -v a="$pct_user" -v b="$pct_sys" 'BEGIN {printf "%.1f", a+b}')
wake=$(( (v1 - v0 + n1 - n0) / secs ))
girq=$(( (g1 - g0) / secs ))
ms_per_wake=$(awk -v p="$pct" -v w="$wake" 'BEGIN {if (w>0) printf "%.2f", p*10/w; else print "-"}')

ran_on=""
for c in $(printf '%s\n' "${!cpus_seen[@]}" | sort -n); do
  ran_on+="${ran_on:+ }cpu$c:${cpus_seen[$c]}"
done

sched=$(ps -o cls=,rtprio=,ni= -p "$pid" | awk '{print $1, "rtprio", $2, "nice", $3}')
gov=""
(( iso_full )) && for c in $(printf '%s\n' "${!iso_set[@]}" | sort -n); do
  g=/sys/devices/system/cpu/cpu$c/cpufreq/scaling_governor
  c6=/sys/devices/system/cpu/cpu$c/cpuidle/state4/disable
  gov+="${gov:+ }cpu$c:$(cat "$g" 2>/dev/null || echo ?)/C6off=$(cat "$c6" 2>/dev/null || echo ?)"
done
gpu_irq_aff=$(for n in $(awk -F: '/i915|xe|amdgpu/ {gsub(/ /,"",$1); print $1}' /proc/interrupts); do
  printf 'irq%s->%s ' "$n" "$(cat /proc/irq/$n/smp_affinity_list 2>/dev/null)"; done)

printf 'hypr-perf  pid %s  %ss sample\n' "$pid" "$secs"
printf '  render thread   %s%% cpu  (user %s%%  sys %s%%)   %s wakeups/s   ~%s ms cpu per wakeup\n' "$pct" "$pct_user" "$pct_sys" "$wake" "$ms_per_wake"
printf '  scheduling      %s   allowed cpus %s\n' "$sched" "$allowed"
printf '  ran on          %s\n' "${ran_on:-?}"
[[ -n $gov ]] && printf '  reserved cpus   %s\n' "$gov"
printf '  gpu irq         %s/s   %s\n' "$girq" "${gpu_irq_aff:-n/a}"
if command -v hyprctl >/dev/null 2>&1; then
  hyprctl monitors -j 2>/dev/null | python3 -c '
import json,sys
try: ms=json.load(sys.stdin)
except Exception: sys.exit(0)
for m in ms:
    print("  monitor         %-6s %dx%d@%.0f%s%s" % (m["name"], m["width"], m["height"], m["refreshRate"],
          "  vrr" if m.get("vrr") else "",
          "  scanout" if str(m.get("directScanoutTo", "0")) not in ("0", "", "None") else ""))
' 2>/dev/null
fi
if (( iso_full )); then
  if (( ${#intruders[@]} == 0 )); then
    printf '  intruders       none on cpus %s\n' "$iso"
  else
    printf '  intruders       on cpus %s:\n' "$iso"
    for k in "${!intruders[@]}"; do printf '    %-28s %s samples\n' "$k" "${intruders[$k]}"; done | sort -k2 -rn | awk 'NR <= 12'
  fi
fi
