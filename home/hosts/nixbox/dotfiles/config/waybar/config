{
  //"layer": "top",
  "output": "DP-1",
  "position": "top",
  "modules-center": ["hyprland/workspaces"],
  "modules-left": [
    //"custom/startmenu",
    "hyprland/window",
    "pulseaudio",
    "custom/eedn-volume"
  ],
  "modules-right": [
    "custom/swaync",
    "custom/exit",
    "tray",
    "clock"
  ],
  "hyprland/workspaces": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": "",
      "inactive": "",
      "urgent": ""
    },
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },
  "clock": {
    "format": "󰥔 {:%a %b %d %I:%M %p}",
    "tooltip": true,
    "tooltip-format": "<tt><b>{calendar}</b></tt>"
  },
  "hyprland/window": {
    "tooltip": false,
    "format": "{}",
    "icon": true,
    "icon-size": 18,
    "max-length": 30,
    "separate-outputs": false,
    "rewrite": {
      "": " NixOS "
    }
  },
  "memory": {
    "interval": 5,
    "format": " {}%",
    "tooltip": false
  },
  "cpu": {
    "interval": 5,
    "format": " {usage:2}%",
    "tooltip": false
  },
  "disk": {
    "format": " {free}",
    "tooltip": false
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-ethernet": " {bandwidthDownOctets}",
    "format-wifi": "{icon} {signalStrength}%",
    "format-disconnected": "󰤮",
    "tooltip": false
  },
  "tray": {
    "spacing": 12,
    "tooltip": false
  },
  "pulseaudio": {
    "tooltip": true,
    "tooltip-format": "{volume}% • {desc}",
    "format": "{icon} {volume}% {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": "󰟎 {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    // Allow scroll/set above 100%
    "max-volume": 300,
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "sleep 0.1 && pavucontrol"
  },
  "custom/eedn-volume": {
    "return-type": "json",
    "exec": "~/.config/hypr/scripts/waybar-eedn-volume.sh status",
    // Fast poll for label; do NOT signal-refresh on scroll (that races and drops ticks)
    "interval": 1,
    "signal": 8,
    // Direct pactl — same ±5% as pulseaudio scroll-step, minimal latency
    "on-scroll-up": "sh -c 'id=$(cat \"$XDG_RUNTIME_DIR/waybar-eedn-volume.id\") && pactl set-sink-input-mute \"$id\" 0; pactl set-sink-input-volume \"$id\" +5%'",
    "on-scroll-down": "sh -c 'id=$(cat \"$XDG_RUNTIME_DIR/waybar-eedn-volume.id\") && pactl set-sink-input-volume \"$id\" -5%'",
    "on-click": "~/.config/hypr/scripts/waybar-eedn-volume.sh mute",
    "tooltip": true
  },
  "custom/exit": {
    "tooltip": false,
    "format": "",
    "on-click": "sleep 0.1 && wlogout"
  },
  "custom/startmenu": {
    "tooltip": false,
    "exec": "python3 /home/teodor/.config/hypr/scripts/weather.py",
    "restart-interval": 300,
    "return-type":"text",
    "format": "{}"
  },
  "custom/hyprbindings": {
    "tooltip": false,
    "format": "󱕴",
    "on-click": "sleep 0.1 && list-hypr-bindings"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip": false
  },
  "custom/swaync": {
    "tooltip": false,
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",  // Bell + red dot
      "none": "",  // Bell
      "dnd-notification": "<span foreground='red'><sup></sup></span>",  // Moon + red dot
      "dnd-none": "",  // Moon
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",  // Bell + red dot
      "inhibited-none": "",  // Bell
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",  // Moon + red dot
      "dnd-inhibited-none": ""  // Moon
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "on-click": "",
    "tooltip": false
  }
}
