{
  //"layer": "top",
  "output": "DP-1",
  "position": "top",
  "modules-center": ["hyprland/workspaces"],
  "modules-left": [
    //"custom/startmenu",
    "hyprland/window",
    "custom/buschain-control"
  ],
  "modules-right": [
    "custom/swaync",
    "custom/exit",
    "tray",
    "clock"
  ],
  "hyprland/workspaces": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": "",
      "inactive": "",
      "urgent": ""
    },
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },
  "clock": {
    "format": "󰥔 {:%a %b %d %I:%M %p}",
    "tooltip": true,
    "tooltip-format": "<tt><b>{calendar}</b></tt>"
  },
  "hyprland/window": {
    "tooltip": false,
    "format": "{}",
    "icon": true,
    "icon-size": 18,
    "max-length": 30,
    "separate-outputs": false,
    "rewrite": {
      "": " NixOS "
    }
  },
  "memory": {
    "interval": 5,
    "format": " {}%",
    "tooltip": false
  },
  "cpu": {
    "interval": 5,
    "format": " {usage:2}%",
    "tooltip": false
  },
  "disk": {
    "format": " {free}",
    "tooltip": false
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-ethernet": " {bandwidthDownOctets}",
    "format-wifi": "{icon} {signalStrength}%",
    "format-disconnected": "󰤮",
    "tooltip": false
  },
  "tray": {
    "spacing": 12,
    "tooltip": false
  },
  // BusChain Control — helper from ~/Projects (status/scroll/popup); rice stays here.
  // Defaults: see buschain-control README "Waybar" section.
  "custom/buschain-control": {
    "format": "{}",
    "return-type": "json",
    "exec": "/home/teodor/Projects/buschain-control/packaging/waybar/buschain-waybar status",
    "interval": 3,
    "signal": 9,
    "exec-on-event": true,
    "on-click": "/home/teodor/Projects/buschain-control/packaging/waybar/buschain-waybar popup",
    "on-scroll-up": "/home/teodor/Projects/buschain-control/packaging/waybar/buschain-waybar up",
    "on-scroll-down": "/home/teodor/Projects/buschain-control/packaging/waybar/buschain-waybar down",
    "tooltip": true
  },
  "custom/exit": {
    "tooltip": false,
    "format": "",
    "on-click": "sleep 0.1 && wlogout"
  },
  "custom/startmenu": {
    "tooltip": false,
    "exec": "python3 /home/teodor/.config/hypr/scripts/weather.py",
    "restart-interval": 300,
    "return-type":"text",
    "format": "{}"
  },
  "custom/hyprbindings": {
    "tooltip": false,
    "format": "󱕴",
    "on-click": "sleep 0.1 && list-hypr-bindings"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip": false
  },
  "custom/swaync": {
    "tooltip": false,
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",  // Bell + red dot
      "none": "",  // Bell
      "dnd-notification": "<span foreground='red'><sup></sup></span>",  // Moon + red dot
      "dnd-none": "",  // Moon
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",  // Bell + red dot
      "inhibited-none": "",  // Bell
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",  // Moon + red dot
      "dnd-inhibited-none": ""  // Moon
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "on-click": "",
    "tooltip": false
  }
}
