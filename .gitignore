# ignore flake.lock for convenience and living on the edge 
flake.lock

# Optional: stable ring (flake.lock.stable.1 … .4) + log from `nixstablesave`
# flake.lock.stable*
# .nix-stable-log.txt

# Nix build outputs and derivations
result
*.drv

# Temporary files and backups
*~
*.swp
*.tmp
*.bak

# Editor-specific directories (adjust as needed)
.vscode/
.idea/

# Logs
*.log

# Ignore any files in directories named "secrets" at any depth.
**/secrets/**

# Asahi peripheral firmware copied from the ESP (not redistributable).
hosts/applenix/firmware/

# If updatebuild is generated or transient, ignore it
updatebuild/

# Optionally, ignore other temporary or cache directories
.cache/
