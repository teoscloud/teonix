+// dockSignature captures dock-relevant state. Active highlight is by class,
+// so switching between windows of the same class must not rebuild.
+func dockSignature() string {
+	classes := make([]string, len(clients))
+	for i, c := range clients {
+		classes[i] = c.Class
+	}
+	sort.Strings(classes)
+	active := ""
+	if activeClient != nil {
+		active = activeClient.Class
+	}
+	return strings.Join(classes, "\n") + "\x00" + active
+}
